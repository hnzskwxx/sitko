# Zkopírujte jako .env a doplňte. Bez ANTHROPIC_API_KEY aplikace běží, ale nehodnotí
# (funguje jen ukázková organizace z `npm run seed:demo`).

# --- AI ---
ANTHROPIC_API_KEY=
# Model (výchozí claude-sonnet-5-5)
AI_MODEL=claude-sonnet-5-5
# Volitelně úsilí modelu: low | medium | high (prázdné = výchozí modelu)
AI_EFFORT=
# Kolik životopisů se hodnotí současně
AI_CONCURRENCY=3
# Měsíční limit hodnocení na organizaci (ochrana nákladů)
MONTHLY_EVALUATION_LIMIT=1000

# --- Server ---
PORT=3000
# Složka pro databázi a nahrané soubory (zálohujte ji)
DATA_DIR=data
# Veřejná adresa, používá se v odkazech pozvánek a kontrole Origin (např. https://sitko.firma.cz).
# Na Renderu není potřeba, Sítko vezme RENDER_EXTERNAL_URL.
PUBLIC_URL=
# Povolit registraci nových firem
ALLOW_REGISTRATION=true
# Na veřejném serveru vyplňte: registrace firmy pak vyžaduje tento kód (chrání váš API klíč)
REGISTRATION_CODE=

# --- Placené členství ---
# true = AI jen pro firmy s aktivním předplatným (aktivuje provozovatel ve Správě)
SUBSCRIPTIONS=false
# E-maily provozovatelů oddělené čárkou: uvidí Správu firem a tarifů
ADMIN_EMAILS=
# Kontakt, který firmy vidí u předplatného (e-mail, telefon)
BILLING_CONTACT=
# Při startu připravit ukázkovou organizaci demo@sitko.local (bez AI, fiktivní data).
# Přihlašovací stránka pak nabídne tlačítko „Otevřít ukázku“ (pro veřejné demo).
SEED_DEMO_ON_START=false
# Délka přihlášení ve dnech
SESSION_DAYS=14
# Cookie jen přes HTTPS (výchozí true v produkci)
COOKIE_SECURE=

# --- Nahrávání ---
MAX_FILE_MB=10
MAX_FILES_PER_UPLOAD=50
